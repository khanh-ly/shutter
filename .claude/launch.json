{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mock-synology",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "dev/mock_server.py",
        "--port",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "mock-synology-expiring",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "dev/mock_server.py",
        "--port",
        "8081",
        "--session-seconds",
        "4"
      ],
      "port": 8081
    },
    {
      "name": "proxy-real-nas",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "dev/mock_server.py",
        "--port",
        "8082",
        "--proxy",
        "http://192.168.1.20:5000"
      ],
      "port": 8082
    },
    {
      "name": "mock-synology-slow",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "dev/mock_server.py",
        "--port",
        "8083",
        "--list-delay",
        "800"
      ],
      "port": 8083
    },
    {
      "name": "showcase",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "dev/mock_server.py",
        "--port",
        "8090",
        "--showcase"
      ],
      "port": 8090
    }
  ]
}
